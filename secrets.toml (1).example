# Local-only template. Copy this to .streamlit/secrets.toml and fill in real
# values ONLY for testing on your own machine — that file is gitignored.
#
# For the actual deployed app, paste these same keys/values into:
#   Streamlit Cloud → your app → Settings → Secrets
# They are stored securely by Streamlit, never committed to GitHub.

APP_PASSWORD = "choose-a-password-here"

ANGEL_API_KEY = "your-angel-api-key"
ANGEL_CLIENT_CODE = "your-angel-client-code"
ANGEL_PASSWORD = "your-angel-login-pin"
ANGEL_TOTP_SECRET = "your-angel-totp-secret"
